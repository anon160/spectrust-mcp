{
  "name": "spectrust-mcp",
  "version": "0.1.0",
  "description": "SpecTrust: The neutral, multi-vendor hardware trust and compatibility layer for AI agents",
  "type": "module",
  "main": "dist/worker.js",
  "bin": {
    "spectrust": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
